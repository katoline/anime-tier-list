{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anime-tier",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // 古いセッション・ログイントークンの掃除（毎日 3:00 JST）
  "triggers": { "crons": ["0 18 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anime-tier",
      // `wrangler d1 create anime-tier` で発行された ID に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES_BUCKET", "bucket_name": "anime-tier-images" }],
  "ratelimits": [
    { "name": "WRITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "SITE_NAME": "アニメティア表メーカー",
    "EMAIL_FROM": "アニメティア表メーカー <noreply@example.com>"
  }
  // シークレット（wrangler secret put で設定）:
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, RESEND_API_KEY, TURNSTILE_SECRET_KEY
}
